    "insight": {
      "what": "The FCI Monthly News Recap: a carousel template for Instagram and LinkedIn, designed for the Future Cities Institute founded by CAIVAN during a 2025 co-op term as Communications Assistant.",
      "problem": "How can stories on urban planning and research be transformed to make them more digestible and accessible to a wider audience?",
      "process": "Drawing attention through colour — the University of Waterloo's brand palette — and through dynamics: lines, rounded shapes and typographic hierarchy that create the motivation for motion.",
      "result": "A contribution to 63% higher impressions and 32.5% growth on LinkedIn in two months."
    },
